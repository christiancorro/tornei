rules_version = '2';

/* ---------------------------------------------------------
   Queste regole SONO il backend.

   Ruoli (campo `role` in users/{uid}):
     user      → scrive annunci, propone tornei (in coda)
     organizer → pubblica tornei direttamente
     admin     → tutto, più la dashboard di moderazione
     blocked   → non scrive niente

   Regola d'oro: nessuno può cambiare il proprio ruolo.
   Solo un admin può scrivere il campo `role`.
--------------------------------------------------------- */
service cloud.firestore {

  match /databases/{database}/documents {

    /* ---------- helper ---------- */

    function isSignedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return profileExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'guest';
    }

    function isAdmin()     { return myRole() == 'admin'; }
    function isOrganizer() { return myRole() == 'organizer' || isAdmin(); }
    function isActive()    { return myRole() in ['user', 'organizer', 'admin']; }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    function isIsoDate(v) {
      return v is string && v.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    /* ---------- users ---------- */

    match /users/{uid} {
      allow read: if true;

      allow create: if isOwner(uid)
        && request.resource.data.role == 'user'
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60;

      allow update: if (isOwner(uid) && unchanged('role') && unchanged('uid')
                        && request.resource.data.displayName is string
                        && request.resource.data.displayName.size() <= 60
                        && (!('photoURL' in request.resource.data)
                            || request.resource.data.photoURL is string))
                    || (isAdmin()
                        && request.resource.data.role in ['user', 'organizer', 'admin', 'blocked']);

      allow delete: if isOwner(uid) || isAdmin();
   
    match /trofei/{torneoId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update, delete: if isOwner(uid);
}
    
    }

    /* ---------- tornei ---------- */

    function validTorneo(d) {
      return d.nome is string && d.nome.size() > 0 && d.nome.size() <= 120
        && d.disciplina in ['Green Volley', 'Beach Volley', 'Pallavolo']
        && d.formati is list && d.formati.size() <= 4
        && isIsoDate(d.data)
        && (!('dataFine' in d) || d.dataFine == '' || isIsoDate(d.dataFine))
        && (!('iscrizioniEntro' in d) || d.iscrizioniEntro == '' || isIsoDate(d.iscrizioniEntro))
        && (!('provincia' in d) || d.provincia in ['UD', 'PN', 'GO', 'TS'])
        && (!('comune' in d) || d.comune.size() <= 80)
        && (!('descrizioneOrganizzatore' in d) || d.descrizioneOrganizzatore.size() <= 1500)
        && (!('lat' in d) || d.lat is number)
        && (!('lng' in d) || d.lng is number);
    }

    match /tornei/{torneoId} {
      allow read: if resource == null
  || isAdmin()
  || resource.data.status == 'published'
  || (isSignedIn() && resource.data.authorId == request.auth.uid);

      allow create: if isActive()
        && validTorneo(request.resource.data)
        && request.resource.data.authorId == request.auth.uid
        && (isOrganizer()
              ? request.resource.data.status in ['published', 'pending']
              : request.resource.data.status == 'pending');

      allow update: if isAdmin()
        || (isActive()
            && resource.data.authorId == request.auth.uid
            && validTorneo(request.resource.data)
            && unchanged('authorId')
            && unchanged('status'));

      allow delete: if isAdmin()
        || (isActive() && resource.data.authorId == request.auth.uid);
    }

    /* ---------- annunci (bacheca) ---------- */

    match /annunci/{annuncioId} {
      allow read: if true;

      allow create: if isActive()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.testo is string
        && request.resource.data.testo.size() > 0
        && request.resource.data.testo.size() <= 600
        && request.resource.data.tipo in ['cerca_squadra', 'cerca_giocatore']
        /* Il conteggio risposte nasce vuoto: nessuno pubblica un
           annuncio che parte già con dieci risposte. */
        && request.resource.data.get('responders', []) == [];

      /* --- Conteggio risposte ----------------------------------------
         Era `if false`, ed era il motivo per cui il numero non si
         muoveva: chi risponde non è l'autore dell'annuncio, quindi la
         sua write veniva rifiutata (in silenzio, per come il client
         ingoia l'errore).

         Un annuncio resta immutabile in tutto tranne che in un campo:
         `responders`, la lista di chi ha aperto un thread. La coppia
         di hasOnly qui sotto dice una cosa sola, in due direzioni:
         l'unico uid che può comparire o sparire dalla lista è il
         proprio.

           nuova ⊆ vecchia + [io]   → non posso aggiungere altri
           vecchia ⊆ nuova + [io]   → non posso togliere altri

         Vale anche per la write che non cambia niente (arrayUnion su
         un uid già presente): affectedKeys() resta vuoto e passa. Il
         client la rimanda a ogni risposta senza prima leggere, quindi
         deve poter essere un no-op.

         `get('responders', [])` è per gli annunci pubblicati prima
         che il campo esistesse: senza default, leggerlo su quei
         documenti fa fallire la regola invece di valere "lista vuota".

         L'admin può togliere anche l'uid di un altro: succede quando
         cancella un thread dalla moderazione. */
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responders'])
        && (
          isAdmin()
          || (
            isActive()
            && request.resource.data.responders
                 .hasOnly(resource.data.get('responders', []).concat([request.auth.uid]))
            && resource.data.get('responders', [])
                 .hasOnly(request.resource.data.responders.concat([request.auth.uid]))
          )
        );

      allow delete: if isAdmin()
        || (isActive() && resource.data.authorId == request.auth.uid);
    }

    /* ---------- messaggi privati ---------- */

    function isParticipant(data) {
      return isSignedIn() && request.auth.uid in data.participants;
    }

    match /conversazioni/{convId} {
      allow read: if isAdmin() || (resource != null && isParticipant(resource.data));

      allow create: if isActive()
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.startedBy == request.auth.uid;

      allow update: if resource != null
        && isParticipant(resource.data)
        && request.resource.data.participants == resource.data.participants;

      allow delete: if isAdmin() || (resource != null && isParticipant(resource.data));

      match /messaggi/{msgId} {
        function conv() {
          return get(/databases/$(database)/documents/conversazioni/$(convId)).data;
        }

        allow read: if isAdmin()
          || (isSignedIn() && request.auth.uid in conv().participants);

        allow create: if isActive()
          && request.auth.uid in conv().participants
          && request.resource.data.fromId == request.auth.uid
          && request.resource.data.testo is string
          && request.resource.data.testo.size() > 0
          && request.resource.data.testo.size() <= 10000;

        allow update: if false;
        allow delete: if isAdmin()
          || (isSignedIn() && request.auth.uid in conv().participants);
      }
    }

    /* ---------- richieste (suggerimenti utenti) ---------- */

    match /richieste/{richiestaId} {
  allow read: if isAdmin()
    || (isSignedIn() && resource.data.authorId == request.auth.uid);

  allow create: if isActive()
    && request.resource.data.authorId == request.auth.uid
    && request.resource.data.testo is string
    && request.resource.data.testo.size() >= 5
    && request.resource.data.testo.size() <= 2000
    && request.resource.data.letto == false;

  // QUESTA regola va QUI (sul parent), non sui figli.
  // L'utente può toccare solo lettoDaUtente e letto, e se
  // cambia letto deve essere false (per non auto-marcarsi
  // come "gestito").
  allow update: if isAdmin()
    || (isSignedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lettoDaUtente', 'letto'])
        && (resource.data.letto == request.resource.data.letto
            || request.resource.data.letto == false));

  allow delete: if isAdmin()
        || (isActive() && resource.data.authorId == request.auth.uid);
        
  match /risposte/{rispostaId} {
    function parent() {
      return get(/databases/$(database)/documents/richieste/$(richiestaId)).data;
    }

    allow read: if isAdmin()
      || (isSignedIn() && request.auth.uid == parent().authorId);

    allow create: if isSignedIn()
      && (isAdmin() || request.auth.uid == parent().authorId)
      && request.resource.data.fromId == request.auth.uid
      && request.resource.data.testo is string
      && request.resource.data.testo.size() > 0
      && request.resource.data.testo.size() <= 10000;

    // QUI torna `if false`: le risposte sono un log immutabile,
    // nessuno le può editare (nemmeno l'admin). Cancellare sì,
    // ma solo l'admin.
    allow update: if false;
    // NB: le risposte hanno `fromId`, non `authorId` (vedi la create
    // qui sopra). Con `authorId` questo ramo non era mai vero e la
    // cancellazione restava di fatto solo dell'admin.
    allow delete: if isAdmin()
  || (isSignedIn() && resource.data.get('fromId', '') == request.auth.uid);
  }
}

    /* ---------- pushTokens (notifiche) ---------- */

    /* Un documento per browser, indirizzato dal token FCM.

       Il token è una stringa lunga e imprevedibile che il browser
       riceve da Google: chi non ce l'ha non può indovinarla. È
       questo che permette di far registrare anche i visitatori NON
       loggati senza aprire la collection a chiunque — si scrive solo
       sul proprio documento, e il proprio documento lo si conosce
       solo se il browser te l'ha dato.

       Dentro non c'è niente di sensibile: tre booleani, il nome del
       dispositivo e, per chi è loggato, il proprio uid.

       L'unico controllo che conta davvero è quello sull'uid: senza,
       chiunque potrebbe registrare un token con l'uid di un altro e
       farsi recapitare i suoi messaggi privati. */

    match /pushTokens/{token} {

      function tokenPlausibile() {
        return token.size() >= 100 && token.size() <= 512;
      }

      /* `admin` è opzionale di proposito: i token registrati prima
         che esistesse non ce l'hanno, e pretenderlo bloccherebbe
         ogni loro aggiornamento successivo. */
      function preferenzeValide(p) {
        return p.keys().hasOnly(['tornei', 'annunci', 'messaggi', 'admin'])
          && p.tornei is bool
          && p.annunci is bool
          && p.messaggi is bool
          && (!('admin' in p.keys()) || p.admin is bool);
      }

      function datiValidi() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'prefs', 'dispositivo', 'updatedAt'])
          && (d.uid == null || (isSignedIn() && d.uid == request.auth.uid))
          && preferenzeValide(d.prefs)
          && (!('dispositivo' in d.keys())
              || (d.dispositivo is string && d.dispositivo.size() <= 40));
      }

      // Leggere il proprio documento serve al client per ritrovare
      // le preferenze; per elencarli tutti bisogna essere loggati e
      // chiedere solo i propri.
      allow get: if true;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow create, update: if tokenPlausibile() && datiValidi();

      // Chi ha il token può spegnere le notifiche su quel browser.
      allow delete: if true;
    }

    /* Tutto il resto è chiuso. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}