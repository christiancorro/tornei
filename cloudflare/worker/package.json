{
  "name": "volleyfvg-social-preview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker che genera le preview social dei tornei davanti a GitHub Pages.",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test test/unit.test.js",
