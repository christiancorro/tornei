    "test:all": "npm test && npm run test:runtime",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "miniflare": "^4.20260730.0",
    "wrangler": "^4.126.0"
  }
}
